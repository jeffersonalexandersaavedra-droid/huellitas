# Variables del sistema. Cópialo como .env.local (en tu PC) y créalas
# también en Vercel (Settings > Environment Variables). Nunca subas las claves reales.

# Supabase (obligatorias)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Facturación electrónica con Nubefact (opcional). Sin ellas, las boletas y
# facturas se emiten en SUNAT o en otro facturador y se registran a mano.
NUBEFACT_RUTA=
NUBEFACT_TOKEN=

# Autocompletar nombre por DNI y razón social por RUC (opcional, decolecta.com)
DECOLECTA_TOKEN=

# Envío de correos: recordatorios de pago y Libro de Reclamaciones (opcional,
# resend.com). RESEND_FROM debe ser de un dominio verificado, ej.:
# Huellitas <avisos@tudominio.pe>
RESEND_API_KEY=
RESEND_FROM=

# Recordatorios automáticos por WhatsApp Business (opcional y de pago, API de
# Meta). WHATSAPP_PLANTILLA: nombre de una plantilla aprobada con 3 variables
# (apoderado, estudiante, detalle de lo pendiente). Idioma por defecto: es.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_PLANTILLA=
WHATSAPP_IDIOMA=

# Contacto de soporte técnico que aparece en Ayuda (opcional)
SOPORTE_NOMBRE=
SOPORTE_WHATSAPP=
SOPORTE_CORREO=

# Tareas programadas (Vercel Cron, ver vercel.json): ping diario para que
# Supabase no pause el proyecto y recordatorios de pago los días 5 y 25.
# Pon una clave larga al azar (mínimo 16 caracteres); Vercel la envía sola.
CRON_SECRET=
