# Variables del sistema. Cópialo como .env.local (en tu PC) y créalas
# también en Vercel (Settings > Environment Variables). Nunca subas las claves reales.

# Supabase (obligatorias)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Facturación electrónica con Nubefact (opcional). Sin ellas, las boletas y
# facturas se emiten en SUNAT o en otro facturador y se registran a mano.
NUBEFACT_RUTA=
NUBEFACT_TOKEN=

# Autocompletar nombre por DNI y razón social por RUC (opcional, decolecta.com)
DECOLECTA_TOKEN=

# Envío de correos: copia del Libro de Reclamaciones y respuestas (opcional,
# resend.com). RESEND_FROM debe ser de un dominio verificado, ej.:
# Huellitas <avisos@tudominio.pe>
RESEND_API_KEY=
RESEND_FROM=
